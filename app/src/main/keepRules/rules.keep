# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Firebase Crashlytics & Coroutines
-keep class com.google.firebase.crashlytics.** { *; }
-dontwarn com.google.firebase.crashlytics.**
-keepattributes *Annotation*,Signature,InnerClasses,EnclosingMethod

# Keep ViewModel constructors initialized via reflection by ViewModelProvider
-keep class * extends androidx.lifecycle.ViewModel {
    <init>(...);
}
-keep class * extends androidx.lifecycle.AndroidViewModel {
    <init>(...);
}
-keep class com.example.uthtodo.ui.viewmodel.** { *; }

# Keep Data Models for Firestore reflection
-keep class com.example.uthtodo.data.model.** { *; }
-keep class com.example.uthtodo.model.** { *; }

# Kotlin stdlib & Firebase Sessions (prevent R8 IllegalAccessError in release obfuscation)
-keep class kotlin.text.** { *; }
-dontwarn kotlin.text.**
-keep class com.google.firebase.sessions.** { *; }
-dontwarn com.google.firebase.sessions.**
-keep class androidx.datastore.** { *; }
-dontwarn androidx.datastore.**

# Credentials & Google Sign-In (Credential Manager)
-keep class androidx.credentials.** { *; }
-dontwarn androidx.credentials.**
-keep class com.google.android.libraries.identity.googleid.** { *; }
-dontwarn com.google.android.libraries.identity.googleid.**
-keep class com.google.android.gms.auth.api.signin.** { *; }
-dontwarn com.google.android.gms.auth.api.signin.**

